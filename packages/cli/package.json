{
  "name": "@catalogus/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "catalogus": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@catalogus/core": "workspace:*",
    "@catalogus/schema": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "^12.1.0",
    "diff": "^8.0.4",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "yaml": "^2.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
