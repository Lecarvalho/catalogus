# Copy to .env and fill in. The one non-blank value below is a sentinel the
# tests assert never reaches the detection result: this detector reads
# variable NAMES only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
OPENAI_API_KEY=SENTINEL-VALUE-MUST-NOT-LEAK
ELEVEN_LABS_API_KEY=
export CLERK_SECRET_KEY=

# Negative controls: names that merely start with the same letters as a
# catalog alias must not match, because matching is on whole tokens.
NOTIONAL_VALUE=
AWSOME_FEATURE=
LINEARIZE_OUTPUT=
